// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id        Int       @id @default(autoincrement())
  fullName  String
  phone     String    @unique
  password  String
  role      String    @default("USER") // USER, ADMIN, CUSTOMER
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@map("user")
}

model Customer {
  id        String   @id @db.VarChar(191)
  name      String   @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  phone     String   @unique @db.VarChar(191)
  status    String   @default("Đang hoạt động") @db.VarChar(191)
  address   String?  @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@map("customer")
}

model Trip {
  id             Int       @id @default(autoincrement())
  code           String    @unique // Mã chuyến (VD: SG-DL-01)
  from         String    // Điểm đi
  to    String    // Điểm đến
  time  DateTime  // Giờ khởi hành
  price          Float     // Giá vé
  availableSeats Int       // Số ghế trống
  createdAt      DateTime  @default(now())
  bookings       Booking[]
}

model Booking {
  id          Int      @id @default(autoincrement())
  seatNumber  String   // Vị trí ghế
  status      String   @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  totalPrice  Float
  userId      Int
  tripId      Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}
