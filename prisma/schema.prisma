generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id         Int      @id @default(autoincrement())
  seatNumber String
  status     String   @default("CONFIRMED")
  totalPrice Float
  userId     Int
  tripId     Int
  createdAt  DateTime @default(now())
  trip       trip     @relation(fields: [tripId], references: [id], onDelete: Cascade, map: "Booking_tripId_fkey")
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Booking_userId_fkey")

  @@index([tripId], map: "Booking_tripId_fkey")
  @@index([userId], map: "Booking_userId_fkey")
}

model trip {
  id             Int       @id @default(autoincrement())
  code           String    @unique(map: "Trip_code_key")
  from           String
  to             String
  time           DateTime
  price          Float
  availableSeats Int
  createdAt      DateTime  @default(now())
  booking        booking[]
}

model user {
  id        Int       @id @default(autoincrement())
  fullName  String
  phone     String    @unique
  password  String
  role      String    @default("USER") // USER, ADMIN, CUSTOMER
  createdAt DateTime  @default(now())
  booking   booking[]

}

model Customer {
  id        String   @id @db.VarChar(191)
  name      String   @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  phone     String   @unique @db.VarChar(191)
  status    String   @default("Đang hoạt động") @db.VarChar(191)
  address   String?  @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@map("customer")
}

model employee {
  id           String   @id
  name         String
  email        String   @unique
  phone        String   @unique
  role         String
  department   String
  status       String   @default("Đang làm việc")
  avatar       String?  @db.Text
  identityCard String?
  address      String?
  startDate    String
  createdAt    DateTime @default(now())
}

model SeatHold {
  id         Int      @id @default(autoincrement())
  tripId     Int
  seatNumber String
  clientId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([tripId, seatNumber])
}
