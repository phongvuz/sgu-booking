generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id             Int       @id @default(autoincrement())
  pnr            String?
  passengerName  String?
  passengerPhone String?
  activeSeat     String?   @unique
  seatNumber     String
  status         String    @default("CONFIRMED")
  totalPrice     Float
  userId         Int
  tripId         Int
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  trip           trip      @relation(fields: [tripId], references: [id], onDelete: Restrict, map: "Booking_tripId_fkey")
  user           user      @relation(fields: [userId], references: [id], onDelete: Restrict, map: "Booking_userId_fkey")

  @@index([pnr])
  @@index([status, createdAt])
  @@index([status, confirmedAt])
  @@index([tripId], map: "Booking_tripId_fkey")
  @@index([userId], map: "Booking_userId_fkey")
}

model trip {
  id             Int        @id @default(autoincrement())
  from           String
  to             String
  time           DateTime
  price          Float
  capacity       Int
  availableSeats Int
  createdAt      DateTime   @default(now())
  booking        booking[]
  seatHolds      SeatHold[]

  @@index([time])
}

model user {
  id        Int       @id @default(autoincrement())
  fullName  String
  phone     String    @unique
  password  String
  role      String    @default("USER") // USER, ADMIN, CUSTOMER
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  booking   booking[]
}

model Customer {
  id        String   @id @db.VarChar(191)
  name      String   @db.VarChar(191)
  email     String   @unique @db.VarChar(191)
  phone     String   @unique @db.VarChar(191)
  status    String   @default("Đang hoạt động") @db.VarChar(191)
  address   String?  @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@map("customer")
}

model employee {
  id           String   @id
  name         String
  email        String   @unique
  phone        String   @unique
  role         String
  department   String
  status       String   @default("Đang làm việc")
  avatar       String?  @db.Text
  identityCard String?
  address      String?
  startDate    String
  createdAt    DateTime @default(now())
}

model SeatHold {
  id         Int      @id @default(autoincrement())
  tripId     Int
  seatNumber String
  clientId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  trip trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNumber])
  @@index([expiresAt])
}

model bus {
  id              String   @id
  plate           String   @unique
  type            String
  seats           Int
  status          String   @default("Đang hoạt động")
  brand           String?
  year            Int?
  driverName      String?
  driverPhone     String?
  lastMaintenance String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
}
